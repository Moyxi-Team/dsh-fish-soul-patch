+	/**
+	 * 开头是不是套话（"刚刷到个…""刷到一个…"这类）：命中就重写一次。
+	 * 跟 openingClash 不同，这个不需要跟历史撞车——第一次用也是模板腔，直接判不合格。
+	 */
+	bannedOpening(text) {
+		const head = String(text ?? '').replace(/^[\s，。,.!！?？、；;:：~～\-—…"'“”「」『』()（）]+/, '').slice(0, 12);
+		return /^(我)?(刚才|刚刚|刚|今天|最近)?(刷到|刷了一个|刷了个|看到一?个|看到一个|翻到一?个|发现一?个|分享一?个|给你看个)/.test(head)
+			|| /^(我)?(刚|刚刚|刚才)?刷(到|完|了)/.test(head);
+	}
+
+	/**
+	 * 开头是不是跟最近发过的撞了（撞了就重写一次）。
+	 * 只比前 4 个字：口头的开场白往往就前两个字重复（"刚刷到…""刚刷到个…"），
+	 * 全文比对太松（后面内容本来就不会一样），抓不住这种套话。
+	 */
+	openingClash(text, limit = 8) {
+		const head = (s) => String(s ?? '').replace(/[\s，。,.!！?？、；;:：~～\-—…"'“”「」『』()（）]/g, '').slice(0, 4);
+		const mine = head(text);
+		if (mine.length < 2) return false;
+		return this.recentPosts(limit).some((r) => head(r.content) === mine);
+	}
+
